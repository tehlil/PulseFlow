# Environment Variables Configuration

# General Config
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database Configuration (PostgreSQL)
# For local run: postgresql://postgres:postgres@localhost:5432/clinical_prediction_engine?schema=public
# For docker-compose run: postgresql://postgres:postgres@postgres:5432/clinical_prediction_engine?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/clinical_prediction_engine?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_prediction_engine

# Redis Configuration (BullMQ & Caching)
# For local run: redis://localhost:6379
# For docker-compose run: redis://redis:6379
REDIS_URL="redis://redis:6379"
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication JWT
# Generate secrets using `openssl rand -base64 32` or similar
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-12345!"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-67890!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Storage Configuration
# Values: LOCAL, S3
STORAGE_PROVIDER=LOCAL
LOCAL_STORAGE_DIR="./uploads"

# AWS S3 Settings (Required if STORAGE_PROVIDER=S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="clinic-predict-documents"
