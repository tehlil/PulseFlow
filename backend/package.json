  "description": "Clinical Prediction Engine Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
